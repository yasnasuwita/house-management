# Diisi otomatis oleh Vercel saat Anda membuat database Postgres (Neon)
# lewat tab Storage di dashboard proyek Vercel. Untuk development lokal,
# salin nilainya dari Vercel dashboard > Project > Storage > .env.local tab.
DATABASE_URL=

# PIN bersama untuk masuk ke aplikasi (bebas, contoh: 246810)
APP_PIN=

# Opsional: ganti label pengguna yang tampil di form input
USER1_LABEL=Saya
USER2_LABEL=Suami
